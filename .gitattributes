# ===============================================================================
# GitHub Linguist Language & Syntax Highlighting Configuration
# ===============================================================================

# 1. Loại bỏ các script build/tiện ích khỏi thống kê Languages bar của GitHub
*.bat linguist-vendored=true
*.sh linguist-vendored=true
CHAY_THU_*.bat linguist-vendored=true
build.bat linguist-vendored=true
build.sh linguist-vendored=true

# 2. Khai báo nhận diện ngôn ngữ TokenVector (.tkv)
*.tkv linguist-detectable=true
*.tkv linguist-language=TokenVector
