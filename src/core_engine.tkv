# -------------------------------------------------------------------------------
def get_platform_os() -> "str":
    # Su dung path_dirname hoac bien moi truong de xac dinh platform
    # Tren POSIX (Linux/macOS), PATH thuong co / hoac bien HOME ton tai
    home_dir = os_getenv("HOME")
    if len(home_dir) > 0:
        # Kiem tra Darwin (macOS) hoac Linux
        user_env = os_getenv("USER")
        if file_exists("/System/Library/CoreServices/SystemVersion.plist") == 1:
            return "macOS"
        return "Linux"
    return "Windows"

def init_core_engine() -> "i32":
    return 1

class PosixRuntimeBridge:
    is_active: "i32"
    def grant_execution_rights(self, target_binary_path: "str") -> "i32":
        current_platform = get_platform_os()
        if current_platform == "Linux" or current_platform == "macOS":
            chmod_cmd = "chmod +x \"" + target_binary_path + "\""
            os_system(chmod_cmd)
            return 1
        return 1


# -------------------------------------------------------------------------------
# 2. Resumable Session & Range State Machine (RFC 9110)
# -------------------------------------------------------------------------------
class ResumableDownloadSession:
    file_path: "str"
    source_url: "str"
    existing_bytes: "i64"
    total_stream_bytes: "i64"
    resumed: "i32"

    def init_session(self, local_output_path: "str", stream_url: "str") -> "i32":
        self.file_path = local_output_path
        self.source_url = stream_url
        self.existing_bytes = 0
        self.total_stream_bytes = 0
        self.resumed = 0
        return 1

    def check_local_offset(self) -> "i64":
        return self.existing_bytes

    def construct_range_header(self) -> "str":
        if self.existing_bytes > 0:
            return "Range: bytes=" + str(self.existing_bytes) + "-"
        return ""

    def process_server_response(self, http_code: "i32", content_length: "i64") -> "i32":
        if http_code == 206:
            self.total_stream_bytes = self.existing_bytes + content_length
            return 1
        elif http_code == 200:
            self.existing_bytes = 0
            self.total_stream_bytes = content_length
            self.resumed = 0
            return 0
        elif http_code == 416:
            return 2
        return -1

    def check_target_exists(self, path: "str") -> "i32":
        return file_exists(path)


# -------------------------------------------------------------------------------
# 3. Throughput & ETA Calculator (EWMA Smoothing Algorithm)
# -------------------------------------------------------------------------------
class TransferMetricsCalculator:
    alpha: "f64"
    smoothed_speed: "f64"

    def init_metrics(self, smoothing_weight: "f64") -> "i32":
        self.alpha = smoothing_weight
        self.smoothed_speed = 0.0
        return 1

    def record_chunk_transfer(self, delta_bytes: "i64", elapsed_seconds: "f64") -> "f64":
        if elapsed_seconds <= 0.0001:
            return self.smoothed_speed

        instantaneous_speed = float(delta_bytes) / elapsed_seconds
        if self.smoothed_speed <= 0.0001:
            self.smoothed_speed = instantaneous_speed
        else:
            self.smoothed_speed = (self.alpha * instantaneous_speed) + ((1.0 - self.alpha) * self.smoothed_speed)

        return self.smoothed_speed

    def estimate_time_remaining(self, total_bytes: "i64", current_bytes: "i64") -> "i32":
        if self.smoothed_speed <= 1.0:
            return -1

        bytes_left = total_bytes - current_bytes
        if bytes_left <= 0:
            return 0

        seconds_remaining = int(float(bytes_left) / self.smoothed_speed)
        return seconds_remaining


